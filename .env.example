# ---------------------------------------------------------------------------
# Migrant Worker Fraud Shield - example environment file
# Copy to .env and fill in. NEVER commit the real .env (it is in .gitignore).
# ---------------------------------------------------------------------------

# Anthropic API key. If empty, the app runs in OFFLINE MODE:
#   - licence checker, fee checker and rule engine keep working (no AI needed)
#   - contract analysis falls back to the deterministic text extractor
#   - /ask returns extractive answers with citations instead of generated prose
ANTHROPIC_API_KEY=

# Model IDs. Verified against Anthropic's model overview page (see README "Sources").
# Override if Anthropic ships a newer snapshot.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_SECONDS=45

# Upload limits
MAX_UPLOAD_MB=10
MAX_UPLOADS_PER_DAY=40

# CORS: comma-separated list of frontend origins. "*" only for local dev.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Human fallback contact shown on every screen.
# LAUNCH BLOCKER: replace with a number verified against BMET / a partner NGO
# and set HELPLINE_VERIFIED=true. While false, the UI shows a clear warning
# instead of pretending the contact is confirmed.
# ---------------------------------------------------------------------------
HELPLINE_BN=16135 (যাচাই করা হয়নি)
HELPLINE_VERIFIED=false

# Institutional partner shown as a trust signal (leave empty until one is signed;
# the UI will not invent a partner).
PARTNER_NAME_BN=
PARTNER_LOGO_URL=

# Set to true only if backend/data/agencies.csv contains the real official BMET
# list. While false, every licence answer carries a red DEMO DATA banner.
AGENCY_DATA_IS_OFFICIAL=false
